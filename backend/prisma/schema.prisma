// This is your Prisma schema file for ATS (Applicant Tracking System)
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums for status fields
enum CandidateStatus {
  NEW
  SCREENING
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ON_HOLD
  CANCELLED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum InterviewType {
  PHONE_SCREEN
  VIDEO_CALL
  ON_SITE
  TECHNICAL
  HR_ROUND
  FINAL_ROUND
}

// Candidate Model
model Candidate {
  id           Int              @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String           @unique
  phone        String?
  resume       String?          // URL or path to resume file
  appliedDate  DateTime         @default(now())
  status       CandidateStatus  @default(NEW)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  
  // Relations
  applications Application[]

  @@map("candidates")
}

// Job Model
model Job {
  id          Int        @id @default(autoincrement())
  title       String
  description String     @db.Text
  department  String
  location    String
  status      JobStatus  @default(DRAFT)
  postedDate  DateTime?
  closedDate  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  // Relations
  recruiterId Int?
  recruiter   Recruiter?    @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  applications Application[]

  @@map("jobs")
}

// Application Model
model Application {
  id              Int               @id @default(autoincrement())
  candidateId     Int
  jobId           Int
  applicationDate DateTime          @default(now())
  status          ApplicationStatus @default(SUBMITTED)
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  // Relations
  candidate  Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job        Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@unique([candidateId, jobId]) // Prevent duplicate applications
  @@map("applications")
}

// Interview Model
model Interview {
  id            Int           @id @default(autoincrement())
  applicationId Int
  interviewDate DateTime
  interviewType InterviewType
  interviewer   String
  feedback      String?       @db.Text
  score         Int?          // Score from 1-10 or 1-100, depending on your system
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  // Relations
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("interviews")
}

// Recruiter Model
model Recruiter {
  id         Int      @id @default(autoincrement())
  firstName  String
  lastName   String
  email      String   @unique
  department String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Relations
  jobs Job[]

  @@map("recruiters")
}